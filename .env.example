# Vidhya Tutorials - Environment Variables Template
# Copy this file to .env or .env.local and configure the values for your environment.

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# Supabase Integration (Required for frontend forms, admissions, & live storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Custom API URL for local server or backend
VITE_API_URL=http://localhost:5000

# ==========================================
# Backend Server Configuration (Node/Express)
# ==========================================
PORT=5000
NODE_ENV=development

# Database & Security Secrets
MONGODB_URI=mongodb://localhost:27017/vidhya_tutorials
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
COOKIE_SECRET=your_cookie_signing_secret
BCRYPT_ROUNDS=10

# Notification Services (Email - Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
NOTIFICATION_EMAIL=vidhyatutorials22@gmail.com

# Notification Services (WhatsApp - Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
ADMIN_WHATSAPP_TO=+918898117343
